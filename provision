#!/usr/bin/env bash
# Build and start SecureInbox with Docker Compose from one env file.
#
#   ./provision                                   uses ./.env, creating it if needed
#   PROVISION_ENV_FILE=/path/to/prod.env ./provision
#
# A development env file is created from .env.example and gets fresh secrets.
# A production env file is only validated: the script never generates secrets
# into it. Both modes are checked for isolation before any container starts.
# docs/environments.md explains each step and check.
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${ROOT}"
# shellcheck disable=SC1091
source "${ROOT}/scripts/dotenv.sh"
ENV_FILE="${PROVISION_ENV_FILE:-${ROOT}/.env}"

log() { printf '\n==> %s\n' "$1"; }
fail() { printf 'Provisioning error: %s\n' "$1" >&2; exit 1; }

compose() {
  docker compose --env-file "${ENV_FILE}" "$@"
}

# Read KEY from the env file into a shell variable of the same name, or stop.
load_required_env_value() {
  local key="$1" value
  value="$(dotenv_get "${key}" "${ENV_FILE}" || true)"
  [[ -n "${value}" && "${value}" != replace-with-a-generated-value ]] || fail "Missing required local configuration value: ${key}"
  printf -v "${key}" '%s' "${value}"
}

# Validate isolation before any containers or demo data are changed.
load_runtime_values() {
  local key shell_value profiles db_uri compose_files
  # Compose prefers exported shell variables over the env file, so an exported
  # DB_URI or COMPOSE_FILE would silently bypass every check below.
  for key in NODE_ENV COMPOSE_PROJECT_NAME COMPOSE_FILE COMPOSE_PROFILES DB_URI SEED_DEMO; do
    if shell_value="$(printenv "$key")" && [[ "$shell_value" != "$(dotenv_get "$key" "$ENV_FILE" || true)" ]]; then
      fail "$key is exported in this shell and would override ${ENV_FILE}. Unset it or put the value in the file."
    fi
  done
  for key in NODE_ENV COMPOSE_PROJECT_NAME APP_PORT; do
    load_required_env_value "$key"
  done
  profiles="$(dotenv_get COMPOSE_PROFILES "$ENV_FILE" || true)"
  db_uri="$(dotenv_get DB_URI "$ENV_FILE" || true)"
  compose_files="$(dotenv_get COMPOSE_FILE "$ENV_FILE" || true)"
  case "$NODE_ENV" in
    production)
      [[ "$COMPOSE_PROJECT_NAME" != *-dev && "$COMPOSE_PROJECT_NAME" != *-test ]] || fail "Production needs a separate project name."
      [[ "$compose_files" == docker-compose.yml:docker-compose.prod.yml ]] || fail "Production requires the production Compose overlay."
      [[ ",$profiles," != *,local-db,* ]] || fail "Production cannot start the development MongoDB."
      [[ "$db_uri" == mongodb+srv://* ]] || fail "Production requires an Atlas DB_URI."
      for key in FRONTEND_APP_URL GOOGLE_REDIRECT_URI; do
        [[ "$(dotenv_get "$key" "$ENV_FILE" || true)" == https://* ]] || fail "Production requires an HTTPS $key."
      done
      [[ "$(dotenv_get SEED_DEMO "$ENV_FILE" || true)" != true ]] || fail "Disable SEED_DEMO in production."
      for key in JWT_SECRET MAIL_TOKEN_ENCRYPTION_KEY FRONTEND_APP_URL GOOGLE_CLIENT_ID GOOGLE_CLIENT_SECRET GOOGLE_REDIRECT_URI EMAIL_FROM EMAIL_PASSWORD TUNNEL_TOKEN; do
        load_required_env_value "$key"
      done
      ;;
    development)
      [[ "$COMPOSE_PROJECT_NAME" == *-dev || "$COMPOSE_PROJECT_NAME" == *-test ]] || fail "Development project name must end in -dev or -test."
      [[ "$compose_files" == docker-compose.yml ]] || fail "Development must use docker-compose.yml."
      [[ -n "$db_uri" || ",$profiles," == *,local-db,* ]] || fail "Set DB_URI or enable the local-db profile."
      [[ -z "$db_uri" || ",$profiles," != *,local-db,* ]] || fail "Clear local-db when using an external DB_URI."
      if [[ -n "$db_uri" ]]; then
        [[ "$db_uri" =~ /[^/?]*(_dev|_test|-dev|-test)(\?|$) ]] || fail "Development DB_URI must select a database ending in dev or test."
      fi
      ;;
    *) fail "NODE_ENV must be development or production." ;;
  esac
}

# Stop early with a readable message when Docker cannot be used.
require_docker() {
  command -v docker >/dev/null 2>&1 || fail "Docker Engine and Docker Compose are required."
  docker info >/dev/null 2>&1 || fail "Docker is not running or this user cannot access it."
  docker compose version >/dev/null 2>&1 || fail "Docker Compose plugin is required."
}

# Point a URL that is empty or still on the example's localhost:8080 at APP_PORT.
# Any other value (a Vite origin, a real hostname) is left alone.
follow_app_port() {
  local key="$1" path="$2" app_port="$3" current target
  current="$(dotenv_get "${key}" "${ENV_FILE}" || true)"
  target="http://localhost:${app_port}${path}"
  if [[ -z "${current}" || "${current}" == "http://localhost:8080${path}" ]] && [[ "${current}" != "${target}" ]]; then
    dotenv_set "${key}" "${target}" "${ENV_FILE}"
  fi
}

# Create or complete a development env file. A production file is only locked
# down to mode 0600; its secrets must already be there.
create_env() {
  if [[ -f "$ENV_FILE" && "$(dotenv_get NODE_ENV "$ENV_FILE" || true)" == production ]]; then
    chmod 0600 "$ENV_FILE"
    return
  fi
  # A .env without NODE_ENV predates the consolidated layout (on the Pi it held
  # only the tunnel and Grafana values). Filling it would generate a new
  # JWT_SECRET and MAIL_TOKEN_ENCRYPTION_KEY, and the stored Gmail tokens could
  # no longer be decrypted. Stop and let a person migrate it.
  if [[ -f "$ENV_FILE" && -z "$(dotenv_get NODE_ENV "$ENV_FILE" || true)" ]]; then
    fail "${ENV_FILE} has no NODE_ENV, so it predates the consolidated configuration. Migrate it first (docs/raspberry-pi-deployment.md); provisioning will not generate secrets into it."
  fi
  command -v openssl >/dev/null 2>&1 || fail "OpenSSL is required to generate local secrets."
  umask 077

  if [[ ! -f "${ENV_FILE}" ]]; then
    log "Generating local configuration"
    cp .env.example "${ENV_FILE}"
  else
    log "Keeping existing .env and filling missing local values"
  fi

  dotenv_set_if_missing MONGO_ROOT_PASSWORD "$(openssl rand -hex 32)" "${ENV_FILE}"
  dotenv_set_if_missing JWT_SECRET "$(openssl rand -hex 32)" "${ENV_FILE}"
  dotenv_set_if_missing MAIL_TOKEN_ENCRYPTION_KEY "$(openssl rand -hex 32)" "${ENV_FILE}"
  dotenv_set_if_missing DEMO_USER_PASSWORD "$(openssl rand -hex 12)" "${ENV_FILE}"
  dotenv_set_if_missing APP_PORT 8080 "${ENV_FILE}"

  local app_port
  app_port="$(dotenv_get APP_PORT "${ENV_FILE}")"
  follow_app_port FRONTEND_APP_URL "" "${app_port}"
  follow_app_port GOOGLE_REDIRECT_URI /api/v1/mail-accounts/google/callback "${app_port}"
  chmod 0600 "${ENV_FILE}"
}

# Validate, build, start, then pull the Ollama model and seed demo data when enabled.
main() {
  require_docker
  create_env

  load_runtime_values

  log "Validating and building the local stack"
  compose config --quiet
  compose up -d --build --wait --wait-timeout 180

  if [[ ",$(dotenv_get COMPOSE_PROFILES "$ENV_FILE" || true)," == *,ai,* ]]; then
    load_required_env_value OLLAMA_MODEL
    log "Preparing the Ollama model"
    if ! compose exec -T ollama ollama list | awk 'NR > 1 { print $1 }' | grep -Fxq "$OLLAMA_MODEL"; then
      compose exec -T ollama ollama pull "$OLLAMA_MODEL"
    fi
  fi

  if [[ "$NODE_ENV" == development && "$(dotenv_get SEED_DEMO "$ENV_FILE" || true)" == true ]]; then
    log "Creating the development demo account and inbox"
    compose exec -T backend npm run seed:local
  fi

  compose ps
  printf '\nSecureInbox %s is ready.\n' "$NODE_ENV"
  printf 'Application: %s\n' "$(dotenv_get FRONTEND_APP_URL "$ENV_FILE")"
  if [[ "$NODE_ENV" == development ]]; then
    printf 'Demo credentials, when seeded: DEMO_USER_EMAIL and DEMO_USER_PASSWORD in %s\n' "$ENV_FILE"
  fi

}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
